package templates

import (
	"fmt"
	"github.com/samson/tidal-weather-clock/internal/domain"
)

templ ConstraintRow(index int, c *domain.Constraint) {
	<div class="constraint-row" data-index={ fmt.Sprintf("%d", index) } style="border:1px solid var(--pico-muted-border-color); border-radius:var(--pico-border-radius); padding:1rem; margin-bottom:1rem">
		<div class="grid">
			<label>
				Type
				<select
					name={ fmt.Sprintf("constraint_type_%d", index) }
					hx-get="/settings/constraint/fields"
					hx-target={ "#constraint-fields-" + fmt.Sprintf("%d", index) }
					hx-trigger="change"
					hx-include="this"
					hx-vals={ fmt.Sprintf(`{"index": "%d"}`, index) }
				>
					<option value="">— Select type —</option>
					<option value="wind_speed" selected?={ c != nil && c.Type == domain.ConstraintWindSpeed }>Wind speed</option>
					<option value="tide_height" selected?={ c != nil && c.Type == domain.ConstraintTideHeight }>Tide height</option>
					<option value="wind_dir" selected?={ c != nil && c.Type == domain.ConstraintWindDir }>Wind direction</option>
					<option value="weather" selected?={ c != nil && c.Type == domain.ConstraintWeather }>Weather</option>
				</select>
			</label>
			<div>
				<label>
					<input
						type="checkbox"
						name={ fmt.Sprintf("constraint_required_%d", index) }
						checked?={ c != nil && c.Required }
					/>
					Required
				</label>
				<label>
					Weight
					<input
						type="number"
						name={ fmt.Sprintf("constraint_weight_%d", index) }
						min="0"
						max="1"
						step="0.1"
						value={ constraintWeight(c) }
					/>
				</label>
			</div>
			<div style="display:flex; align-items:flex-start; justify-content:flex-end">
				<button
					type="button"
					class="outline contrast"
					style="width:auto"
					onclick="this.closest('.constraint-row').remove()"
				>Remove</button>
			</div>
		</div>
		<div id={ "constraint-fields-" + fmt.Sprintf("%d", index) }>
			if c != nil && c.Type != "" {
				@ConstraintFields(index, c.Type, c)
			}
		</div>
	</div>
}

templ ConstraintFields(index int, cType domain.ConstraintType, c *domain.Constraint) {
	switch cType {
	case domain.ConstraintWindSpeed:
		@numericFields(index, c, "kts")
	case domain.ConstraintTideHeight:
		@numericFields(index, c, "metres")
	case domain.ConstraintWindDir:
		@directionFields(index, c)
	case domain.ConstraintWeather:
		@weatherFields(index, c)
	}
}

templ numericFields(index int, c *domain.Constraint, unit string) {
	<fieldset>
		<legend>Range <small>({ unit })</small></legend>
		<div class="grid">
			for _, f := range []struct{ label, field string }{
				{"Acceptable min", "acceptable_min"},
				{"Ideal min", "ideal_min"},
				{"Ideal max", "ideal_max"},
				{"Acceptable max", "acceptable_max"},
			} {
				<label>
					{ f.label }
					<input
						type="number"
						step="0.1"
						name={ fmt.Sprintf("constraint_%s_%d", f.field, index) }
						value={ constraintNumeric(c, f.field, unit) }
						if unit == "kts" {
							data-bf-hint={ fmt.Sprintf("bf-%s-%d", f.field, index) }
							oninput="updateBf(this)"
						}
					/>
					if unit == "kts" {
						<small id={ fmt.Sprintf("bf-%s-%d", f.field, index) }></small>
					}
				</label>
			}
		</div>
	</fieldset>
}

templ directionFields(index int, c *domain.Constraint) {
	<fieldset>
		<legend>Preferred directions</legend>
		<div style="display:flex; flex-wrap:wrap; gap:1rem">
			for _, pt := range CompassPoints {
				<label style="display:flex; align-items:center; gap:0.25rem; margin:0">
					<input
						type="checkbox"
						name={ fmt.Sprintf("constraint_directions_%d", index) }
						value={ pt.Label }
						checked?={ c != nil && sliceContains(degsToPoints(c.Preferred), pt.Label) }
					/>
					{ pt.Label }
				</label>
			}
		</div>
	</fieldset>
	<label>
		Tolerance (degrees)
		<input
			type="number"
			step="0.5"
			name={ fmt.Sprintf("constraint_tolerance_%d", index) }
			value={ constraintTolerance(c) }
		/>
	</label>
}

templ weatherFields(index int, c *domain.Constraint) {
	<div class="grid">
		<fieldset>
			<legend>Acceptable</legend>
			for _, opt := range WeatherOptions {
				<label>
					<input
						type="checkbox"
						name={ fmt.Sprintf("constraint_acceptable_weather_%d", index) }
						value={ string(opt.Code) }
						checked?={ c != nil && sliceContains(c.Acceptable, string(opt.Code)) }
					/>
					{ opt.Label }
				</label>
			}
		</fieldset>
		<fieldset>
			<legend>Ideal (subset of acceptable)</legend>
			for _, opt := range WeatherOptions {
				<label>
					<input
						type="checkbox"
						name={ fmt.Sprintf("constraint_ideal_weather_%d", index) }
						value={ string(opt.Code) }
						checked?={ c != nil && sliceContains(c.Ideal, string(opt.Code)) }
					/>
					{ opt.Label }
				</label>
			}
		</fieldset>
	</div>
}

func constraintWeight(c *domain.Constraint) string {
	if c == nil || c.Required {
		return "1"
	}
	return fmt.Sprintf("%.1f", c.Weight)
}

func constraintTolerance(c *domain.Constraint) string {
	if c == nil {
		return "22.5"
	}
	return fmt.Sprintf("%.1f", c.Tolerance)
}

// constraintNumeric returns the display value for a numeric field, converting
// m/s → kts for wind speed constraints.
func constraintNumeric(c *domain.Constraint, field, unit string) string {
	if c == nil {
		return ""
	}
	var v float64
	switch field {
	case "acceptable_min":
		v = c.AcceptableMin
	case "ideal_min":
		v = c.IdealMin
	case "ideal_max":
		v = c.IdealMax
	case "acceptable_max":
		v = c.AcceptableMax
	}
	if unit == "kts" {
		v = msToKts(v)
	}
	if v == 0 {
		return ""
	}
	return fmt.Sprintf("%g", v)
}
