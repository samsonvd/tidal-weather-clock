package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ title } — Tidal Weather Clock</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<script src="https://unpkg.com/htmx.org@2/dist/htmx.min.js"></script>
			<script>
				function bfFromKts(kts) {
					const ms = kts * 0.514444;
					if (ms < 0.3) return 0; if (ms < 1.6) return 1; if (ms < 3.4) return 2;
					if (ms < 5.5) return 3; if (ms < 8.0) return 4; if (ms < 10.8) return 5;
					if (ms < 13.9) return 6; if (ms < 17.2) return 7; if (ms < 20.8) return 8;
					if (ms < 24.5) return 9; if (ms < 28.5) return 10; if (ms < 32.7) return 11;
					return 12;
				}
				function updateBf(el) {
					const hint = document.getElementById(el.dataset.bfHint);
					if (hint) hint.textContent = 'F' + bfFromKts(parseFloat(el.value) || 0);
				}
				function initBfHints(root) {
					(root || document).querySelectorAll('[data-bf-hint]').forEach(updateBf);
				}
				document.addEventListener('DOMContentLoaded', () => initBfHints());
				document.addEventListener('htmx:afterSwap', e => initBfHints(e.detail.elt));
			</script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
