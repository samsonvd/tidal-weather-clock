package templates

templ Login(sent bool, hasError bool) {
	@Layout("Log in") {
		<main class="container" style="max-width:480px; margin-top:4rem">
			<article>
				<hgroup>
					<h1>Tidal Weather Clock</h1>
					<p>Enter your email to sign in or create an account.</p>
				</hgroup>
				if sent {
					<p>
						<strong>Check your email.</strong>
						We've sent you a sign-in link — it expires in 15 minutes.
					</p>
					<p><a href="/login">← Back</a></p>
				} else {
					if hasError {
						<p><small style="color:var(--pico-color-red-500)">That link is invalid or has expired. Please request a new one.</small></p>
					}
					<form method="post" action="/login">
						<label>
							Email address
							<input
								type="email"
								name="email"
								placeholder="you@example.com"
								autocomplete="email"
								autofocus
								required
							/>
						</label>
						<button type="submit">Send sign-in link</button>
					</form>
				}
			</article>
		</main>
	}
}
