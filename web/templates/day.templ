package templates

import (
	"fmt"
	"github.com/samson/tidal-weather-clock/internal/scoring"
)

templ DayView(data DayViewData) {
	@Layout(formatDate(data.Date)) {
		<header class="container-fluid">
			<nav>
				<ul>
					<li><strong>Tidal Weather Clock</strong></li>
				</ul>
				<ul>
					<li>
						<a href={ templ.SafeURL("/day/" + data.PrevDate) } role="button" class="outline secondary">←</a>
						&nbsp;{ formatDate(data.Date) }&nbsp;
						<a href={ templ.SafeURL("/day/" + data.NextDate) } role="button" class="outline secondary">→</a>
					</li>
				</ul>
				<ul>
					if data.User != nil {
						<li>
							<form method="post" action="/auth/logout" style="margin:0">
								<button type="submit" class="outline secondary">Log out</button>
							</form>
						</li>
					} else {
						<li><a href="/login" role="button" class="outline">Log in</a></li>
					}
				</ul>
			</nav>
		</header>
		<main class="container">
			if !data.HasData {
				<article>
					<p>No weather data available for this date.</p>
					<p>Run <code>mise run fetch</code> to populate data.</p>
				</article>
			} else {
				<section>
					<h2>Conditions</h2>
					<figure>
						<table>
							<thead>
								<tr>
									<th>Time</th>
									<th>Weather</th>
									<th>Wind</th>
									<th>Tide</th>
								</tr>
							</thead>
							<tbody>
								for _, h := range data.Hours {
									<tr>
										<td>{ formatTime(h.Time) }</td>
										<td>{ weatherLabel(h.Weather) }</td>
										<td>{ fmt.Sprintf("%.1f m/s %s", h.WindSpeedMS, compassPoint(h.WindDirDeg)) }</td>
										<td>{ fmt.Sprintf("%.2fm", h.TideHeightM) }</td>
									</tr>
								}
							</tbody>
						</table>
					</figure>
				</section>
				if data.User != nil {
					<section>
						<h2>Activities</h2>
						if len(data.Windows) == 0 {
							<p>No activities configured. <a href="/settings/activities">Add some.</a></p>
						} else {
							for _, w := range data.Windows {
								if !w.Excluded {
									@windowCard(w)
								}
							}
						}
					</section>
				}
			}
		</main>
	}
}

templ windowCard(w scoring.ScoredWindow) {
	<article>
		<header>
			<div style="display:flex; justify-content:space-between; align-items:baseline">
				<strong>{ w.Activity.Name }</strong>
				<span>{ scorePercent(w.Score) }</span>
			</div>
			<small>{ formatTime(w.Start) } – { formatTime(w.End) }</small>
		</header>
		<details>
			<summary>Constraint details</summary>
			<table>
				<thead>
					<tr>
						<th>Type</th>
						<th>Required</th>
						<th>Score</th>
						<th>Per hour</th>
					</tr>
				</thead>
				<tbody>
					for _, cr := range w.ConstraintResults {
						<tr>
							<td>{ string(cr.Constraint.Type) }</td>
							<td>
								if cr.Constraint.Required {
									✓
								} else {
									–
								}
							</td>
							<td>{ scorePercent(cr.Score) }</td>
							<td><small>{ formatHourScores(cr.HourScores) }</small></td>
						</tr>
					}
				</tbody>
			</table>
		</details>
	</article>
}
