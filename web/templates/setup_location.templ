package templates

import (
	"fmt"
	"github.com/samson/tidal-weather-clock/internal/fetcher"
)

templ SetupLocation(groups []fetcher.StationGroup) {
	@Layout("Choose your location") {
		<main class="container">
			<hgroup>
				<h1>Choose your location</h1>
				<p>Select the tidal station closest to where you want to track conditions.</p>
			</hgroup>
			<input
				type="search"
				id="station-search"
				placeholder="Search stations..."
				autocomplete="off"
				autofocus
			/>
			<form method="post" action="/setup/location">
				for _, group := range groups {
					<details open>
						<summary>{ group.Country } <small>({ fmt.Sprintf("%d", len(group.Stations)) })</small></summary>
						<ul>
							for _, station := range group.Stations {
								<li data-name={ station.Name }>
									<label>
										<input type="radio" name="station_id" value={ station.ID }/>
										{ station.Name }
									</label>
								</li>
							}
						</ul>
					</details>
				}
				<button type="submit">Set location</button>
			</form>
			<script>
				const search = document.getElementById('station-search');
				search.addEventListener('input', () => {
					const q = search.value.toLowerCase();
					document.querySelectorAll('details').forEach(d => {
						let count = 0;
						d.querySelectorAll('li[data-name]').forEach(li => {
							const match = !q || li.dataset.name.toLowerCase().includes(q);
							li.hidden = !match;
							if (match) count++;
						});
						d.hidden = count === 0;
						if (q) d.open = count > 0;
					});
				});
			</script>
		</main>
	}
}
