package templates

import (
	"fmt"
	"github.com/samson/tidal-weather-clock/internal/domain"
)

templ ActivityList(user *domain.User, activities []domain.Activity) {
	@Layout("Activities") {
		<header class="container-fluid">
			<nav>
				<ul>
					<li><a href="/">← Day view</a></li>
				</ul>
				<ul>
					<li><strong>Activities</strong></li>
				</ul>
				<ul>
					<li>
						<form method="post" action="/auth/logout" style="margin:0">
							<button type="submit" class="outline secondary">Log out</button>
						</form>
					</li>
				</ul>
			</nav>
		</header>
		<main class="container">
			<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem">
				<h2 style="margin:0">Your activities</h2>
				<a href="/settings/activities/new" role="button">+ New activity</a>
			</div>
			if len(activities) == 0 {
				<article>
					<p>No activities yet. Add one to start getting scored windows on the day view.</p>
				</article>
			} else {
				for _, a := range activities {
					<article>
						<div style="display:flex; justify-content:space-between; align-items:baseline">
							<div>
								<strong>{ a.Name }</strong>
								<br/>
								<small>
									{ fmt.Sprintf("%dh window", a.DurationHrs) } &nbsp;·&nbsp;
									{ formatHour(a.WindowStart) }–{ formatHour(a.WindowEnd) } &nbsp;·&nbsp;
									{ fmt.Sprintf("%d constraint(s)", len(a.Constraints)) }
								</small>
							</div>
							<div style="display:flex; gap:0.5rem">
								<a href={ templ.SafeURL("/settings/activities/" + a.ID.String() + "/edit") } role="button" class="outline secondary">Edit</a>
								<button
									hx-delete={ "/settings/activities/" + a.ID.String() }
									hx-target="closest article"
									hx-swap="delete"
									hx-confirm={ "Delete " + a.Name + "?" }
									class="outline contrast"
								>Delete</button>
							</div>
						</div>
					</article>
				}
			}
		</main>
	}
}
