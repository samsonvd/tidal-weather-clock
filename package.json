{
  "name": "tidal-weather-clock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "drizzle-kit push && next build",
    "dev": "next dev --turbopack",
    "drizzle:push": "drizzle-kit push --verbose",
    "drizzle:seed": "bun run ./src/lib/db/seed.ts",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed",
    "format": "prettier --experimental-cli --write . && next lint --fix",
    "lint": "next lint",
    "lint:format": "prettier --experimental-cli --cache --check .",
    "pre-commit": "prettier --experimental-cli --write --ignore-unknown",
    "start": "next start",
    "test": "vitest",
    "test:ci": "vitest --run"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^3.0.83",
    "@auth0/nextjs-auth0": "^4.15.0",
    "@date-fns/tz": "^1.4.1",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-markdown-preview": "^5.1.5",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^1.1.1",
    "@vercel/edge-config": "^1.4.3",
    "ai": "^5.0.137",
    "array-equal": "^2.0.0",
    "bun-plugin-tailwind": "^0.0.14",
    "cartesian-product": "^2.1.2",
    "change-case": "^5.4.4",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.1.0",
    "diff-arrays-of-objects": "^1.1.9",
    "drizzle-orm": "^0.44.7",
    "express": "^5.2.1",
    "fast-equals": "^5.4.0",
    "jsdom": "^26.1.0",
    "json-edit-react": "^1.29.0",
    "launchdarkly-react-client-sdk": "^3.9.0",
    "lucide-react": "^0.533.0",
    "next": "^15.5.12",
    "openmeteo": "^1.2.3",
    "pino": "^9.14.0",
    "react": "19.1.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.1.0",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.2",
    "react-router": "^7.13.0",
    "react-swipeable": "^7.0.2",
    "tailwindcss": "^4.2.0",
    "theme-change": "^2.5.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@jest/globals": "^30.2.0",
    "@ljharb/tsconfig": "^0.3.2",
    "@next/eslint-plugin-next": "^15.5.12",
    "@playwright/test": "^1.58.2",
    "@pollyjs/adapter-fetch": "^6.0.7",
    "@pollyjs/core": "^6.0.6",
    "@pollyjs/persister-fs": "^6.0.6",
    "@prettier/plugin-oxc": "^0.0.4",
    "@tailwindcss/cli": "^4.2.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "3.2.4",
    "daisyui": "^5.5.19",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.3",
    "eslint-config-next": "15.3.2",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^18.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^2.5.22",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
